<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Assets\MSFSCacheManager.ico</ApplicationIcon>
		<Version>2.0.0</Version>
		<Authors>Andrew M Brown</Authors>
		<Product>MSFS Cache Manager</Product>
		<Description>Backup, inspect, clear, and restore Microsoft Flight Simulator cache data.</Description>
		<RepositoryUrl>https://github.com/macbrowndog/MSFSCacheManager</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Assets\MSFSCacheManager.ico" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Assets\Images\" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Tests\**\*.cs" />
		<EmbeddedResource Remove="Tests\**\*" />
		<None Remove="Tests\**\*" />
	</ItemGroup>

</Project>
