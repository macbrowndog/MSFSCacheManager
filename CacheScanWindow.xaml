<Window x:Class="MSFSCacheManager.CacheScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cache Scan Results"
        Height="600"
        Width="900"
        MinHeight="450"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="#15171A">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel Grid.Row="0">

            <TextBlock Text="Cache Scan Results"
                       Foreground="White"
                       FontSize="26"
                       FontWeight="Bold"/>

            <TextBlock x:Name="ResultCountText"
                       Text="Detected cache locations"
                       Foreground="#AEB4BC"
                       FontSize="14"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- RESULTS -->

        <Border Grid.Row="2"
                Background="#202328"
                BorderBrush="#353A42"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">

            <ListBox x:Name="CacheList"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     FontFamily="Consolas"
                     FontSize="13">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Border BorderBrush="#353A42"
                                BorderThickness="0,0,0,1"
                                Padding="10">

                            <TextBlock Text="{Binding}"
                                       TextWrapping="Wrap"
                                       Foreground="White"/>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Border>


        <!-- CLOSE BUTTON -->

        <Button Grid.Row="4"
                Content="Close"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                Click="CloseButton_Click"/>

    </Grid>

</Window>