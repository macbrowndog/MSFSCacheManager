<Window x:Class="MSFSCacheManager.Windows.BackupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Manager"
        Height="650"
        Width="900"
        MinHeight="500"
        MinWidth="760"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Backup Manager"
                       FontSize="24"
                       FontWeight="Bold"/>

            <TextBlock Text="View backup sessions and their cleanup reports."
                       Margin="0,5,0,0"
                       Opacity="0.65"/>
        </StackPanel>

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Backup Sessions">

                <ListBox x:Name="BackupSessionsList"
                         Margin="8"
                         SelectionChanged="BackupSessionsList_SelectionChanged"/>
            </GroupBox>

            <GroupBox Grid.Column="2"
                      Header="Backup Report">

                <TextBox x:Name="ReportTextBox"
                         Margin="8"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Width="110"
                    Margin="0,0,10,0"
                    Content="Refresh"
                    Click="RefreshButton_Click"/>

            <Button Width="130"
                    Margin="0,0,10,0"
                    Content="Open Session"
                    Click="OpenSessionButton_Click"/>

            <Button Width="130"
                    Margin="0,0,10,0"
                    Content="Open Report"
                    Click="OpenReportButton_Click"/>

            <Button Width="90"
                    Content="Close"
                    Click="CloseButton_Click"/>
        </StackPanel>

    </Grid>
</Window>
