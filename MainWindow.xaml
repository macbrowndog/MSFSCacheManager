<Window x:Class="MSFSCacheManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MSFS Cache Manager"
        Height="820"
        Width="1050"
        MinHeight="760"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D10"
        FontFamily="Segoe UI Variable Text">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- MODERN ACTION BUTTON                                  -->
        <!-- ===================================================== -->

        <Style x:Key="ModernButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="54"/>

            <Setter Property="Margin"
                    Value="0,0,0,10"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#E8EAED"/>

            <Setter Property="Background"
                    Value="#1A1D22"/>

            <Setter Property="BorderBrush"
                    Value="#2B3038"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#242931"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#3C4654"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303640"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Opacity"
                                        Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ===================================================== -->
        <!-- BLUE TOOL BUTTON                                      -->
        <!-- ===================================================== -->

        <Style x:Key="ToolButton"
               TargetType="Button"
               BasedOn="{StaticResource ModernButton}">

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#14243A"/>

            <Setter Property="BorderBrush"
                    Value="#1D4774"/>

            <Setter Property="Foreground"
                    Value="#8EC5FF"/>

        </Style>


        <!-- ===================================================== -->
        <!-- SECTION LABEL                                         -->
        <!-- ===================================================== -->

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="#7F8997"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Margin"
                    Value="2,0,0,12"/>

        </Style>

    </Window.Resources>


    <!-- ========================================================= -->
    <!-- MAIN LAYOUT                                               -->
    <!-- ========================================================= -->

    <Grid>

        <!-- Subtle top accent -->

        <Border Height="3"
                VerticalAlignment="Top"
                Background="#1683D8"/>


        <Grid Margin="40,32,40,28">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="20"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="28"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="25"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- APP TITLE -->

                <StackPanel>

                    <TextBlock Text="MSFS Cache Manager"
                               Foreground="#F4F6F8"
                               FontSize="30"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Cache &amp; Shader Management"
                               Foreground="#7F8997"
                               FontSize="14"
                               Margin="1,5,0,0"/>

                </StackPanel>


                <!-- VERSION + SETTINGS -->

                <StackPanel Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">

                    <Border Background="#15181D"
            BorderBrush="#292E36"
            BorderThickness="1"
            CornerRadius="14"
            Padding="14,6"
            Margin="0,0,10,0">

                        <TextBlock Text="VERSION 1.1"
                   Foreground="#8D96A3"
                   FontSize="11"
                   FontWeight="SemiBold"/>

                    </Border>

                    <Button x:Name="SettingsButton"
            Content="⚙ Settings"
            Width="100"
            Height="32"
            Click="SettingsButton_Click"/>
                </StackPanel>

            </Grid>

            <!-- ================================================= -->
            <!-- STATUS CARD                                       -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="#121519"
                    BorderBrush="#292E36"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="15"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- STATUS INDICATOR -->

                    <Border Width="10"
                            Height="10"
                            CornerRadius="5"
                            Background="#46C778"
                            VerticalAlignment="Center"/>


                    <!-- STATUS TEXT -->

                    <StackPanel Grid.Column="2">

                        <TextBlock Text="SYSTEM STATUS"
                                   Foreground="#697381"
                                   FontSize="10"
                                   FontWeight="Bold"/>

                        <TextBlock x:Name="StatusText"
                                   Text="Ready"
                                   Foreground="#E7EAEE"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>

                    </StackPanel>


                    <!-- READY INDICATOR -->

                    <TextBlock Grid.Column="3"
                               Text="●  READY"
                               Foreground="#46C778"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- MAIN DASHBOARD                                    -->
            <!-- ================================================= -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="25"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- LEFT COLUMN                                       -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="0">


                    <!-- STANDARD CACHE MAINTENANCE -->

                    <TextBlock Text="STANDARD CACHE MAINTENANCE"
                               Style="{StaticResource SectionTitle}"/>


                    <Button x:Name="MSFSCacheButton"
                            Content="MSFS Cache"
                            Style="{StaticResource ModernButton}"
                            Click="MSFSCacheButton_Click"/>


                    <Button x:Name="RollingCacheButton"
                            Content="Rolling Cache"
                            Style="{StaticResource ModernButton}"
                            Click="RollingCacheButton_Click"/>


                    <!-- GPU CACHE -->

                    <TextBlock Text="GPU CACHE"
                               Style="{StaticResource SectionTitle}"
                               Margin="2,20,0,12"/>


                    <Button x:Name="ShaderCacheButton"
                            Content="GPU Shader Cache"
                            Style="{StaticResource ModernButton}"
                            Click="ShaderCacheButton_Click"/>


                    <!-- TOOLS -->

                    <TextBlock Text="TOOLS"
                               Style="{StaticResource SectionTitle}"
                               Margin="2,20,0,12"/>


                    <Button x:Name="ScanButton"
                            Content="Scan Cache Locations"
                            Style="{StaticResource ToolButton}"
                            Click="ScanButton_Click"/>


                    <Button x:Name="BackupButton"
                            Content="Open Backups Folder"
                            Style="{StaticResource ToolButton}"
                            Click="BackupButton_Click"/>

                    <Button x:Name="BackupManagerButton"
                            Content="Manage Backup Sessions"
                            Style="{StaticResource ToolButton}"
                             Click="BackupManagerButton_Click"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- RIGHT COLUMN                                      -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="2">


                    <!-- ADVANCED / TROUBLESHOOTING -->

                    <TextBlock Text="ADVANCED / TROUBLESHOOTING"
                               Style="{StaticResource SectionTitle}"/>


                    <TextBlock
                        Text="Use these options only when troubleshooting specific simulator issues. Backups are created before cache data is removed."
                        Foreground="#8A94A6"
                        FontSize="12"
                        TextWrapping="Wrap"
                        LineHeight="18"
                        Margin="2,0,0,15"/>


                    <!-- SCENERY -->

                    <Button x:Name="SceneryCacheButton"
                            Content="Scenery Cache"
                            Style="{StaticResource ModernButton}"
                            Click="SceneryCacheButton_Click"/>


                    <Button x:Name="SceneryIndexesButton"
                            Content="Scenery Indexes"
                            Style="{StaticResource ModernButton}"
                            Click="SceneryIndexesButton_Click"/>


                    <!-- ADVANCED GRID -->

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="10"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- LEFT ADVANCED COLUMN -->

                        <StackPanel Grid.Column="0">

                            <Button x:Name="DCEButton"
                                    Content="DCE Cache (MSFS2020)"
                                    Style="{StaticResource ModernButton}"
                                    Click="DCEButton_Click"/>


                            <Button x:Name="SimObjectsButton"
                                    Content="SimObjects"
                                    Style="{StaticResource ModernButton}"
                                    Click="SimObjectsButton_Click"/>

                        </StackPanel>


                        <!-- RIGHT ADVANCED COLUMN -->

                        <StackPanel Grid.Column="2">

                            <Button x:Name="StreamedPackagesButton"
                                    Content="Streamed Packages"
                                    Style="{StaticResource ModernButton}"
                                    Click="StreamedPackagesButton_Click"/>


                            <Button x:Name="WASMButton"
                                    Content="WASM Cache"
                                    Style="{StaticResource ModernButton}"
                                    Click="WASMButton_Click"/>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- FOOTER                                            -->
            <!-- ================================================= -->

            <Grid Grid.Row="6">

                <TextBlock
        Text="MSFS Cache Manager • Version 1.1 • Andrew M Brown • © 2026"
        Foreground="#515966"
        FontSize="11"
        HorizontalAlignment="Left"/>

                <TextBlock
        Text="Backups are created before cache data is removed"
        Foreground="#515966"
        FontSize="11"
        HorizontalAlignment="Right"/>

            </Grid>

        </Grid>

    </Grid>

</Window>
