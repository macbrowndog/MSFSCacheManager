<Window x:Class="MSFSCacheManager.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About MSFS Cache Manager"
        Height="560"
        Width="680"
        MinHeight="500"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D10"
        Foreground="#E8EAED"
        FontFamily="Segoe UI Variable Text">

    <Window.Resources>

        <Style x:Key="CloseButtonStyle"
               TargetType="Button">

            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="#D9E3EE"/>
            <Setter Property="Background" Value="#1A1D22"/>
            <Setter Property="BorderBrush" Value="#39414C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252B33"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#566270"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303842"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle"
               TargetType="TextBlock">

            <Setter Property="Foreground" Value="#8EC5FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Blue accent line -->

        <Border Height="3"
                VerticalAlignment="Top"
                Background="#1683D8"/>

        <Grid Margin="32,28,32,26">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->

            <StackPanel>

                <TextBlock Text="MSFS Cache Manager"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="#F4F6F8"/>

                <TextBlock Text="Cache &amp; Shader Management Utility"
                           Margin="1,5,0,0"
                           FontSize="13"
                           Foreground="#7F8997"/>

            </StackPanel>

            <!-- CONTENT -->

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel>

                    <Border Background="#121519"
                            BorderBrush="#292E36"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="18"
                            Margin="0,0,0,18">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Version 1.0"
                                           Foreground="#F4F6F8"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="Created by Andrew M Brown"
                                           Margin="0,5,0,0"
                                           Foreground="#A8B2BF"/>

                                <TextBlock Text="Copyright © 2026 Andrew M Brown"
                                           Margin="0,3,0,0"
                                           Foreground="#7F8997"
                                           FontSize="12"/>

                            </StackPanel>

                            <TextBlock Grid.Column="1"
                                       Text="VERSION 1.0"
                                       VerticalAlignment="Center"
                                       Foreground="#8EC5FF"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>

                        </Grid>
                    </Border>

                    <TextBlock Text="About"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="MSFS Cache Manager helps users locate, back up, and clear selected Microsoft Flight Simulator cache data. Backups are created before supported cache data is removed."
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="#D9E3EE"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="MSFS 2020 Compatibility Notice"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="MSFS Cache Manager has been developed and tested primarily with Microsoft Flight Simulator 2024. Some features include support for Microsoft Flight Simulator 2020, but the application has not yet been fully tested with MSFS 2020. Retain all backups and use additional caution when using MSFS 2020."
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="#D9E3EE"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Important"
                               Style="{StaticResource SectionTitle}"/>

                    <TextBlock Text="Microsoft Flight Simulator should be completely closed before performing cleanup. Advanced options should only be used when troubleshooting a specific problem. Keep backups until you have confirmed that the simulator is operating normally."
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Foreground="#D9E3EE"
                               Margin="0,0,0,20"/>

                    <Border Background="#14243A"
                            BorderBrush="#1D4774"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14">

                        <TextBlock Text="MSFS Cache Manager is an independent utility and is not affiliated with or endorsed by Microsoft Corporation, Xbox Game Studios, or Asobo Studio."
                                   TextWrapping="Wrap"
                                   LineHeight="19"
                                   Foreground="#A8C7E8"
                                   FontSize="12"/>

                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- CLOSE -->

            <Button Grid.Row="4"
                    Content="Close"
                    HorizontalAlignment="Right"
                    Style="{StaticResource CloseButtonStyle}"
                    Click="CloseButton_Click"/>

        </Grid>
    </Grid>
</Window>