<Window x:Class="MSFSCacheManager.CacheScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cache Scan Results"
        Height="700"
        Width="1200"
        MinHeight="520"
        MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="#15171A"
        Foreground="#F4F6F8"
        FontFamily="Segoe UI Variable Text">

    <Grid Margin="28">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>

            <StackPanel>
                <TextBlock Text="Cache Scan Results"
                           FontSize="27"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="ResultCountText"
                           Margin="0,5,0,0"
                           Foreground="#AEB4BC"
                           FontSize="14"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="#14243A"
                    BorderBrush="#1D4774"
                    BorderThickness="1"
                    CornerRadius="15"
                    Padding="14,7">

                <TextBlock Text="STANDARD = ROUTINE  •  ADVANCED = TROUBLESHOOTING"
                           Foreground="#8EC5FF"
                           FontSize="10"
                           FontWeight="SemiBold"/>
            </Border>

        </Grid>

        <Border Grid.Row="2"
                Background="#202328"
                BorderBrush="#353A42"
                BorderThickness="1"
                CornerRadius="7"
                Padding="1">

            <DataGrid x:Name="CacheGrid"
                      ItemsSource="{Binding}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#353A42"
                      Background="#202328"
                      Foreground="#F4F6F8"
                      BorderThickness="0"
                      RowBackground="#202328"
                      AlternatingRowBackground="#1B1E22"
                      EnableRowVirtualization="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#171A1F"/>
                        <Setter Property="Foreground" Value="#AEB4BC"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,9"/>
                        <Setter Property="BorderBrush" Value="#353A42"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="8,7"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="ToolTip" Value="{Binding Path}"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Use" Width="52">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Click="SelectionCheckBox_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}"
                                        IsReadOnly="True"
                                        Width="145"/>

                    <DataGridTextColumn Header="Simulator"
                                        Binding="{Binding Simulator}"
                                        IsReadOnly="True"
                                        Width="105"/>

                    <DataGridTextColumn Header="Platform"
                                        Binding="{Binding Platform}"
                                        IsReadOnly="True"
                                        Width="140"/>

                    <DataGridTextColumn Header="Risk"
                                        Binding="{Binding RiskLevel}"
                                        IsReadOnly="True"
                                        Width="90"/>

                    <DataGridTextColumn Header="Size"
                                        Binding="{Binding FormattedSize}"
                                        IsReadOnly="True"
                                        Width="90"/>

                    <DataGridTextColumn Header="Files"
                                        Binding="{Binding FileCount, StringFormat=N0}"
                                        IsReadOnly="True"
                                        Width="75"/>

                    <DataGridTextColumn Header="Last Modified"
                                        Binding="{Binding FormattedLastModified}"
                                        IsReadOnly="True"
                                        Width="135"/>

                    <DataGridTextColumn Header="Location"
                                        Binding="{Binding Path}"
                                        IsReadOnly="True"
                                        Width="*"/>
                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <Grid Grid.Row="4">

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="SelectedSummaryText"
                           FontSize="14"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Selection is informational and does not remove cache data."
                           Margin="0,3,0,0"
                           Foreground="#7F8997"
                           FontSize="11"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Content="Select All"
                        Width="105"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="SelectAllButton_Click"/>

                <Button Content="Select None"
                        Width="105"
                        Height="38"
                        Margin="0,0,10,0"
                        Click="SelectNoneButton_Click"/>

                <Button Content="Close"
                        Width="105"
                        Height="38"
                        Click="CloseButton_Click"/>
            </StackPanel>

        </Grid>

    </Grid>

</Window>
