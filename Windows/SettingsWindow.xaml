<Window x:Class="MSFSCacheManager.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="760"
        Width="760"
        MinHeight="650"
        MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D10"
        Foreground="#E8EAED"
        FontFamily="Segoe UI Variable Text">

    <Window.Resources>

        <!-- ===================================================== -->
        <!-- GROUP PANEL                                          -->
        <!-- ===================================================== -->

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="#121519"
                                BorderBrush="#292E36"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="#8EC5FF"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontSize="13"/>

                                <ContentPresenter Grid.Row="1"
                                                  ContentSource="Content"
                                                  Margin="0,14,0,0"/>
                            </Grid>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================== -->
        <!-- TEXT BOX                                             -->
        <!-- ===================================================== -->

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="#E8EAED"/>
            <Setter Property="Background" Value="#0D1014"/>
            <Setter Property="BorderBrush" Value="#3A424D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="#8EC5FF"/>
        </Style>

        <!-- ===================================================== -->
        <!-- SECONDARY BUTTON                                     -->
        <!-- ===================================================== -->

        <Style x:Key="SecondaryButton"
               TargetType="Button">

            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="#D9E3EE"/>
            <Setter Property="Background" Value="#1A1D22"/>
            <Setter Property="BorderBrush" Value="#39414C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252B33"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#566270"/>
                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303842"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================================================== -->
        <!-- PRIMARY BUTTON                                       -->
        <!-- ===================================================== -->

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">

            <Setter Property="Background" Value="#146EB4"/>
            <Setter Property="BorderBrush" Value="#2389D6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ===================================================== -->
        <!-- FIELD LABEL                                          -->
        <!-- ===================================================== -->

        <Style x:Key="FieldLabel"
               TargetType="TextBlock">

            <Setter Property="Foreground" Value="#84909E"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- Blue accent line -->

        <Border Height="3"
                VerticalAlignment="Top"
                Background="#1683D8"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="32,28,32,28">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- HEADER                                            -->
                <!-- ================================================= -->

                <StackPanel>

                    <TextBlock Text="Settings"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#F4F6F8"/>

                    <TextBlock Text="Application, installation, and backup preferences"
                               Margin="1,5,0,0"
                               FontSize="13"
                               Foreground="#7F8997"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- APPLICATION                                       -->
                <!-- ================================================= -->

                <GroupBox Grid.Row="2"
                          Header="APPLICATION">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Version"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBlock Text="1.1"
                                       Margin="0,4,0,0"
                                       Foreground="#E8EAED"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">

                            <TextBlock Text="Author"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBlock Text="Andrew M Brown"
                                       Margin="0,4,0,0"
                                       Foreground="#E8EAED"/>
                        </StackPanel>

                        <Button Grid.Row="2"
                                Grid.ColumnSpan="3"
                                Width="185"
                                HorizontalAlignment="Left"
                                Content="About MSFS Cache Manager"
                                Style="{StaticResource SecondaryButton}"
                                Click="AboutButton_Click"/>

                    </Grid>
                </GroupBox>

                <!-- ================================================= -->
                <!-- MSFS INSTALLATION                                 -->
                <!-- ================================================= -->

                <GroupBox Grid.Row="4"
                          Header="MSFS INSTALLATION">

                    <StackPanel>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Detection Status"
                                       Style="{StaticResource FieldLabel}"/>

                            <TextBlock x:Name="DetectionStatusText"
                                       Grid.Column="1"
                                       Foreground="#58D68D"
                                       FontWeight="SemiBold"
                                       Text="Checking..."/>

                        </Grid>

                        <TextBlock Text="UserCfg.opt"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,4"/>

                        <TextBlock x:Name="UserCfgPathText"
                                   Foreground="#D9E3EE"
                                   Text="Checking..."
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Active Packages Folder"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,16,0,4"/>

                        <TextBlock x:Name="PackagesPathText"
                                   Foreground="#D9E3EE"
                                   Text="Checking..."
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Manual Packages Folder Override"
                                   Style="{StaticResource FieldLabel}"
                                   Margin="0,18,0,4"/>

                        <TextBlock Text="Leave this blank to use automatic UserCfg.opt detection."
                                   FontSize="11"
                                   Foreground="#74808E"
                                   Margin="0,0,0,7"/>

                        <TextBox x:Name="PackagesFolderOverrideTextBox"
                                 Margin="0,0,0,10"/>

                        <Button Width="120"
                                HorizontalAlignment="Left"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowsePackagesButton_Click"/>

                    </StackPanel>
                </GroupBox>

                <!-- ================================================= -->
                <!-- BACKUPS                                           -->
                <!-- ================================================= -->

                <GroupBox Grid.Row="6"
                          Header="BACKUPS">

                    <StackPanel>

                        <TextBlock Text="Backup Folder"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBlock Text="All cache cleanup operations are moved to this location first."
                                   FontSize="11"
                                   Foreground="#74808E"
                                   Margin="0,4,0,7"/>

                        <TextBox x:Name="BackupFolderTextBox"
                                 Margin="0,0,0,10"/>

                        <Button Width="120"
                                HorizontalAlignment="Left"
                                Content="Browse..."
                                Style="{StaticResource SecondaryButton}"
                                Click="BrowseBackupButton_Click"/>

                    </StackPanel>
                </GroupBox>

                <!-- ================================================= -->
                <!-- BUTTONS                                           -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="8"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Width="130"
                            Margin="0,0,10,0"
                            Content="Restore Defaults"
                            Style="{StaticResource SecondaryButton}"
                            Click="RestoreDefaultsButton_Click"/>

                    <Button Width="95"
                            Margin="0,0,10,0"
                            Content="Save"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveButton_Click"/>

                    <Button Width="95"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click"/>

                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>