<Window x:Class="MSFSCacheManager.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="720"
        Width="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========================================= -->
            <!-- TITLE                                     -->
            <!-- ========================================= -->

            <TextBlock Text="⚙ Settings"
                       FontSize="24"
                       FontWeight="Bold"/>

            <!-- ========================================= -->
            <!-- APPLICATION                               -->
            <!-- ========================================= -->

            <GroupBox Grid.Row="2"
                      Header="Application">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Version"/>

                    <TextBlock Grid.Column="1"
                               Text="1.0"/>

                    <TextBlock Grid.Row="1"
                               Text="Author"/>

                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="Andrew M Brown"/>

                    <Button Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Width="170"
                            HorizontalAlignment="Left"
                            Content="About MSFS Cache Manager"
                            Click="AboutButton_Click"/>

                </Grid>
            </GroupBox>

            <!-- ========================================= -->
            <!-- MSFS INSTALLATION                         -->
            <!-- ========================================= -->

            <GroupBox Grid.Row="4"
                      Header="MSFS Installation">

                <StackPanel Margin="10">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Detection"/>

                        <TextBlock x:Name="DetectionStatusText"
                                   Grid.Column="1"
                                   Text="Checking..."/>
                    </Grid>

                    <TextBlock Text="UserCfg.opt"
                               Margin="0,12,0,2"/>

                    <TextBlock x:Name="UserCfgPathText"
                               Text="Checking..."
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Active Packages Folder"
                               Margin="0,12,0,2"/>

                    <TextBlock x:Name="PackagesPathText"
                               Text="Checking..."
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Manual Packages Folder Override"
                               Margin="0,15,0,2"/>

                    <TextBlock Text="Leave blank to use automatic detection."
                               FontSize="11"
                               Opacity="0.65"
                               Margin="0,0,0,5"/>

                    <TextBox x:Name="PackagesFolderOverrideTextBox"
                             Margin="0,0,0,10"/>

                    <Button Width="120"
                            HorizontalAlignment="Left"
                            Content="Browse..."
                            Click="BrowsePackagesButton_Click"/>

                </StackPanel>
            </GroupBox>

            <!-- ========================================= -->
            <!-- BACKUPS                                   -->
            <!-- ========================================= -->

            <GroupBox Grid.Row="6"
                      Header="Backups">

                <StackPanel Margin="10">

                    <TextBlock Text="Backup Folder"/>

                    <TextBox x:Name="BackupFolderTextBox"
                             Margin="0,5,0,10"/>

                    <Button Width="120"
                            HorizontalAlignment="Left"
                            Content="Browse..."
                            Click="BrowseBackupButton_Click"/>

                </StackPanel>
            </GroupBox>

            <!-- ========================================= -->
            <!-- BUTTONS                                   -->
            <!-- ========================================= -->

            <StackPanel Grid.Row="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Width="120"
                        Margin="0,0,10,0"
                        Content="Restore Defaults"
                        Click="RestoreDefaultsButton_Click"/>

                <Button Width="90"
                        Margin="0,0,10,0"
                        Content="Save"
                        Click="SaveButton_Click"/>

                <Button Width="90"
                        Content="Cancel"
                        Click="CancelButton_Click"/>

            </StackPanel>

        </Grid>
    </ScrollViewer>
</Window>