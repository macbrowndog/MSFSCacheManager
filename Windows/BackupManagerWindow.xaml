<Window x:Class="MSFSCacheManager.Windows.BackupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backup Manager"
        Height="680"
        Width="1120"
        MinHeight="540"
        MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Background="#0B0D10"
        Foreground="#E8EAED"
        FontFamily="Segoe UI Variable Text">

    <Window.Resources>

        <Style x:Key="SecondaryButton"
               TargetType="Button">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#E8EAED"/>

            <Setter Property="Background"
                    Value="#1A1D22"/>

            <Setter Property="BorderBrush"
                    Value="#2B3038"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#242931"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#3C4654"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303640"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">

            <Setter Property="Background"
                    Value="#1268AD"/>

            <Setter Property="BorderBrush"
                    Value="#1683D8"/>

            <Setter Property="Foreground"
                    Value="White"/>

        </Style>

        <Style TargetType="GroupBox">

            <Setter Property="Foreground"
                    Value="#D8DEE7"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="GroupBox">

                        <Border Background="#121519"
                                BorderBrush="#292E36"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="16">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{TemplateBinding Header}"
                                           Foreground="#F4F6F8"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>

                                <ContentPresenter Grid.Row="2"/>

                            </Grid>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="ListBox">

            <Setter Property="Background"
                    Value="#0E1014"/>

            <Setter Property="BorderBrush"
                    Value="#2B3038"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#E8EAED"/>

            <Setter Property="Padding"
                    Value="5"/>

        </Style>

        <Style TargetType="ListBoxItem">

            <Setter Property="Padding"
                    Value="10,8"/>

            <Setter Property="Margin"
                    Value="0,1"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#D8DEE7"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#1A2532"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#17456D"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid>

        <Border Height="3"
                VerticalAlignment="Top"
                Background="#1683D8"/>

        <Grid Margin="32,30,32,28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>

                <StackPanel>

                    <TextBlock Text="Backup Manager"
                               Foreground="#F4F6F8"
                               FontSize="28"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Review backup sessions, inspect reports, and restore cached data."
                               Foreground="#7F8997"
                               FontSize="14"
                               Margin="1,5,0,0"/>

                </StackPanel>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#14243A"
                        BorderBrush="#1D4774"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12,6">

                    <TextBlock Text="BACKUP HISTORY"
                               Foreground="#8EC5FF"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                </Border>

            </Grid>

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="Backup Sessions">

                    <ListBox x:Name="BackupSessionsList"
                             SelectionChanged="BackupSessionsList_SelectionChanged"/>

                </GroupBox>

                <GroupBox Grid.Column="2"
                          Header="Backup Report">

                    <TextBox x:Name="ReportTextBox"
                             Background="#0E1014"
                             BorderBrush="#2B3038"
                             BorderThickness="1"
                             Foreground="#D8DEE7"
                             FontFamily="Consolas"
                             FontSize="12"
                             Padding="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                </GroupBox>

            </Grid>

            <Grid Grid.Row="4">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="RestoreProgressPanel"
                      Grid.ColumnSpan="2"
                      Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <ProgressBar Height="6"
                                     IsIndeterminate="True"/>

                        <TextBlock x:Name="RestoreProgressText"
                                   Margin="0,7,12,0"
                                   Foreground="#8A94A6"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button x:Name="CancelRestoreButton"
                            Grid.Column="1"
                            Width="105"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelRestoreButton_Click"/>

                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Restore never overwrites files already in the active location."
                           Foreground="#7F8997"
                           FontSize="12"
                           VerticalAlignment="Center"/>

                <StackPanel x:Name="SessionActionsPanel"
                            Grid.Row="2"
                            Grid.Column="1"
                            Orientation="Horizontal">

                    <Button Width="105"
                            Margin="0,0,10,0"
                            Content="Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Click="RefreshButton_Click"/>

                    <Button Width="125"
                            Margin="0,0,10,0"
                            Content="Open Session"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenSessionButton_Click"/>

                    <Button Width="125"
                            Margin="0,0,10,0"
                            Content="Open Report"
                            Style="{StaticResource SecondaryButton}"
                            Click="OpenReportButton_Click"/>

                    <Button x:Name="RestoreButton"
                            Width="135"
                            Margin="0,0,10,0"
                            Content="Restore Session"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButton}"
                            Click="RestoreButton_Click"/>

                    <Button Width="90"
                            Content="Close"
                            Style="{StaticResource SecondaryButton}"
                            Click="CloseButton_Click"/>

                </StackPanel>

            </Grid>

        </Grid>

    </Grid>

</Window>
