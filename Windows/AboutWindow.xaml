<Window x:Class="MSFSCacheManager.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About MSFS Cache Manager"
        Height="500"
        Width="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>

            <TextBlock Text="MSFS Cache Manager"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Cache &amp; Shader Management Utility"
                       Margin="0,5,0,0"
                       Opacity="0.65"/>

        </StackPanel>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="Version 1.0"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Created by Andrew M Brown"
                           Margin="0,4,0,0"/>

                <TextBlock Text="Copyright © 2026 Andrew M Brown"
                           Margin="0,4,0,18"/>

                <TextBlock Text="About"
                           FontWeight="Bold"
                           FontSize="16"/>

                <TextBlock Text="MSFS Cache Manager helps users locate, back up, and clear selected Microsoft Flight Simulator cache data. Backups are created before supported cache data is removed."
                           TextWrapping="Wrap"
                           Margin="0,6,0,18"/>

                <TextBlock Text="MSFS 2020 Compatibility Notice"
                           FontWeight="Bold"
                           FontSize="16"/>

                <TextBlock Text="MSFS Cache Manager has been developed and tested primarily with Microsoft Flight Simulator 2024. Some features include support for Microsoft Flight Simulator 2020, but the application has not yet been fully tested with MSFS 2020. Retain all backups and use additional caution when using MSFS 2020."
                           TextWrapping="Wrap"
                           Margin="0,6,0,18"/>

                <TextBlock Text="Important"
                           FontWeight="Bold"
                           FontSize="16"/>

                <TextBlock Text="Microsoft Flight Simulator should be completely closed before performing cleanup. Advanced options should only be used when troubleshooting a specific problem. Keep backups until you have confirmed that the simulator is operating normally."
                           TextWrapping="Wrap"
                           Margin="0,6,0,18"/>

                <TextBlock Text="MSFS Cache Manager is an independent utility and is not affiliated with or endorsed by Microsoft Corporation, Xbox Game Studios, or Asobo Studio."
                           TextWrapping="Wrap"
                           Opacity="0.65"/>
            </StackPanel>

        </ScrollViewer>

        <Button Grid.Row="4"
                Width="100"
                Height="32"
                HorizontalAlignment="Right"
                Content="Close"
                Click="CloseButton_Click"/>

    </Grid>
</Window>